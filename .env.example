# Configuración MSAL / Microsoft Entra ID (SDD §32)
# Copia este archivo a .env y completa con los valores de tu App Registration.
# clientId y tenantId NO son secretos (son identificadores públicos de la SPA),
# pero se mantienen fuera del código fuente por buenas prácticas.
VITE_CLIENT_ID=tu-client-id
VITE_TENANT_ID=tu-tenant-id
VITE_REDIRECT_URI=http://localhost:5173
# URL del API Gateway (Fase 4 - cliente HTTP)
VITE_API_URL=http://localhost:8080
# Scope del API expuesto por el BFF (opcional hasta definirlo en el App Registration)
# VITE_API_SCOPE=api://tu-client-id/access_as_user
